# @template/mobile — copy to .env and fill in
# Schema of record: src/env.ts
#
# NOTE: EXPO_PUBLIC_* values are inlined into the app bundle at build time.
# Never put a secret here — only publishable/client-side keys.

# Base URL of the @template/api service (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Sentry ---
# Client key (DSN) of the Sentry project. Leave empty to send no events.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only, for the source map upload in release builds. Not put in
# the app bundle. For EAS builds, set them in the EAS environment instead.
# Set SENTRY_DISABLE_AUTO_UPLOAD=true to build a release without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
