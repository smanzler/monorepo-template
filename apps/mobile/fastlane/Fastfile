# Uploads the store listings: text from fastlane/metadata, screenshots from
# fastlane/screenshots/ios and fastlane/metadata/android/*/images. The
# screenshots lanes capture those images with Maestro. Builds and release
# notes stay with EAS. See "Store listing" in the root README.md.

require "json"
require "tmpdir"

APP_DIR = File.expand_path("..", __dir__)
MAESTRO_FLOW = File.join(APP_DIR, ".maestro/screenshots.yaml")

# Returns the values of the env vars. Stops with the names of all that are
# not set or empty.
def fetch_env(*names)
  missing = names.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Set these env vars: #{missing.join(", ")}") unless missing.empty?
  names.map { |name| ENV[name] }
end

# Runs the screenshots flow on a booted simulator or emulator, and copies its
# screenshots into `dest`.
def capture_screenshots(device:, dest:)
  # Set here, not on the command, so fastlane doesn't log them.
  ENV["MAESTRO_REVIEW_EMAIL"], ENV["MAESTRO_REVIEW_OTP"] = fetch_env("REVIEW_EMAIL", "REVIEW_OTP")

  Dir.mktmpdir do |out|
    # Older Maestro versions save screenshots in the working directory, newer
    # ones in the test output directory.
    Dir.chdir(out) do
      sh("maestro", "test", "--device", device, "--test-output-dir", out, MAESTRO_FLOW)
    end

    shots = Dir.glob(File.join(out, "**", "[0-9][0-9]-*.png"))
    UI.user_error!("Maestro saved no screenshots") if shots.empty?
    FileUtils.mkdir_p(dest)
    shots.each { |shot| FileUtils.cp(shot, File.join(dest, File.basename(shot))) }
  end
end

# supply logs only the message of a Google API error, but the reason is in the
# body. The body has no credentials.
module LogGoogleApiErrorBody
  def call_google_api(&block)
    super() do
      block.call
    rescue Google::Apis::Error => e
      UI.error("Google API error body: #{e.body}")
      raise
    end
  end
end

def clear_screenshots(dest)
  FileUtils.rm_f(Dir.glob(File.join(dest, "*.{png,jpg,jpeg}")))
end

platform :ios do
  desc "Capture the App Store screenshots on a 6.9\" iPhone simulator"
  desc "Options: iphone, to use another simulator of the same size"
  lane :screenshots do |options|
    name = options[:iphone] || "iPhone 17 Pro Max"
    dest = File.join(APP_DIR, "fastlane/screenshots/ios/en-US")
    clear_screenshots(dest)
    ENV["SENTRY_DISABLE_AUTO_UPLOAD"] = "true"

    simulator = JSON.parse(
      sh("xcrun", "simctl", "list", "devices", "available", "--json", log: false),
    )["devices"].values.flatten.find { |s| s["name"] == name }
    UI.user_error!("No available simulator named \"#{name}\"") unless simulator
    udid = simulator["udid"]

    sh("xcrun", "simctl", "bootstatus", udid, "-b")
    sh("xcrun", "simctl", "status_bar", udid, "override",
       "--time", "9:41", "--dataNetwork", "wifi", "--wifiBars", "3",
       "--cellularMode", "active", "--cellularBars", "4",
       "--batteryState", "charged", "--batteryLevel", "100")
    # Expo CLI 57 sees a simulator in the Xcode 27 devicectl list as a
    # physical device and stops on the install, so simctl installs the build.
    Dir.mktmpdir do |out|
      Dir.chdir(APP_DIR) do
        sh("npx", "expo", "run:ios", "--configuration", "Release", "--device", "generic", "--output", out)
      end
      sh("xcrun", "simctl", "install", udid, Dir.glob(File.join(out, "*.app")).first)
    end
    capture_screenshots(device: udid, dest: dest)
    sh("xcrun", "simctl", "status_bar", udid, "clear")
  end

  desc "Upload the App Store listing and screenshots"
  lane :metadata do
    *, review_email, review_otp, first_name, last_name, contact_email, phone = fetch_env(
      "APP_STORE_CONNECT_API_KEY_KEY_ID",
      "APP_STORE_CONNECT_API_KEY_ISSUER_ID",
      "APP_STORE_CONNECT_API_KEY_KEY",
      "REVIEW_EMAIL",
      "REVIEW_OTP",
      "REVIEW_CONTACT_FIRST_NAME",
      "REVIEW_CONTACT_LAST_NAME",
      "REVIEW_CONTACT_EMAIL",
      "REVIEW_CONTACT_PHONE",
    )
    app_store_connect_api_key
    upload_to_app_store(
      metadata_path: "./fastlane/metadata/ios",
      screenshots_path: "./fastlane/screenshots/ios",
      app_review_information: {
        first_name: first_name,
        last_name: last_name,
        email_address: contact_email,
        # Apple requires "+" and the country code.
        phone_number: phone,
        demo_user: review_email,
        demo_password: review_otp,
        notes: "Sign in with email. Enter the demo account email, then the " \
               "demo password as the 6-digit code. No email is sent.",
      },
      skip_binary_upload: true,
      # Only replaces the screenshots of languages that have local ones.
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end
end

platform :android do
  desc "Capture the Play Store phone screenshots on the running emulator"
  lane :screenshots do
    serials = sh("adb", "devices", log: false).lines.grep(/\tdevice$/).map { |line| line.split("\t").first }
    UI.user_error!("Start exactly one emulator, found #{serials.count}") unless serials.count == 1
    serial = serials.first

    dest = File.join(APP_DIR, "fastlane/metadata/android/en-US/images/phoneScreenshots")
    clear_screenshots(dest)
    ENV["SENTRY_DISABLE_AUTO_UPLOAD"] = "true"
    # This build never reaches Play, so the debug key can sign it when no
    # upload key is set.
    ENV["ORG_GRADLE_PROJECT_TEMPLATE_UPLOAD_STORE_FILE"] ||= "debug.keystore"
    ENV["ORG_GRADLE_PROJECT_TEMPLATE_UPLOAD_STORE_PASSWORD"] ||= "android"
    ENV["ORG_GRADLE_PROJECT_TEMPLATE_UPLOAD_KEY_ALIAS"] ||= "androiddebugkey"
    ENV["ORG_GRADLE_PROJECT_TEMPLATE_UPLOAD_KEY_PASSWORD"] ||= "android"

    demo = ->(command, *extras) do
      sh("adb", "-s", serial, "shell", "am", "broadcast", "-a", "com.android.systemui.demo",
         "-e", "command", command, *extras)
    end
    sh("adb", "-s", serial, "shell", "settings", "put", "global", "sysui_demo_allowed", "1")
    demo.call("enter")
    demo.call("clock", "-e", "hhmm", "0941")
    demo.call("battery", "-e", "level", "100", "-e", "plugged", "false")
    demo.call("network", "-e", "wifi", "show", "-e", "level", "4")
    demo.call("network", "-e", "mobile", "show", "-e", "datatype", "none", "-e", "level", "4")
    demo.call("notifications", "-e", "visible", "false")

    begin
      Dir.chdir(APP_DIR) do
        sh("npx", "expo", "run:android", "--variant", "release", "--no-bundler")
      end
      capture_screenshots(device: serial, dest: dest)
    ensure
      demo.call("exit")
    end
  end

  desc "Upload the Play Store listing and screenshots"
  lane :metadata do
    json_key = fetch_env("SUPPLY_JSON_KEY_DATA").first
    begin
      account = JSON.parse(json_key).fetch("client_email")
    rescue JSON::ParserError, KeyError
      UI.user_error!("SUPPLY_JSON_KEY_DATA is not a service account JSON key")
    end
    # Play Console must give this account access to the app.
    UI.message("Signing in to Google Play as #{account}")
    require "supply"
    Supply::AbstractGoogleServiceClient.prepend(LogGoogleApiErrorBody)
    # supply attaches the listing edit to a release on this track, and stops
    # when it cannot find exactly one. EAS submits to internal.
    track = "internal"
    version_code = google_play_track_version_codes(track: track).max
    UI.user_error!("The #{track} track has no release") unless version_code
    upload_to_play_store(
      metadata_path: "./fastlane/metadata/android",
      track: track,
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      # Only replaces the screenshot types that have local ones, and skips
      # files the store already has.
      sync_image_upload: true,
    )
  end
end
